require('./mount')()

var creepsProduce = require('./creeps.produce');
var creepProduce = require('creep.produce');

var roleBuilder = require('role.builder');
var thirdRoomUpgrader = require('room.third.upgrader');
//外矿相关
var roleClaimer = require('role.claimer');
var roleMining = require('role.mining');
var support = require('support');


var W54N9 = require('room.w54n9');
var W51N9 = require('room.w51n9');
var W54N8 = require('room.w54n8');
var W55N13 = require('room.W55N13');
var W57N13 = require('room.w57n13');
var W58N12 = require('room.w58n12');


var roleTower = require('role.tower');
var roleLink = require('role.link');
var roleLab = require('role.lab');
var roleBase = require('role.base');
var market = require('./market')


module.exports.loop = function () {




    creepsProduce.run()
    //market.terminal()

    for(var name in Game.creeps) {
        var creep = Game.creeps[name];


        if(creep.memory.role.includes('BaseAllAround')) {
            roleBase.run(creep);
        }


        if(creep.memory.role == 'W58N12B-EnergyCarry') {
            W58N12.energyCarry(creep);
        }
        if(creep.memory.role == 'energyHarvester'){
            W58N12.harvester(creep)
        }
        if(creep.memory.role.indexOf("transferA") !=-1){
            W58N12.A(creep)
        }


        if(creep.memory.role == 'builder') {
            //support.build(creep);
            roleBuilder.run(creep)
        }
        if(creep.memory.role == 'builder1') {
            support.W51N9build(creep);
        }
        //
        if(creep.memory.role == 'claimer') {
            roleClaimer.claimer(creep)
        }


        //房间w57n13-creep
        if(creep.memory.role == 'W57N13LEnergyCarry') {
            W57N13.energyCarry(creep);
        }
        if(creep.memory.role == 'W57N13L-ResourcesTransfer') {
            W57N13.resourceTransfer(creep);
        }


        // if(creep.memory.role == 'W57N13TResourceTransfer'){
        //     secondRoomHarvester.resourceTransfer(creep);
        // }



        //W55N13creep
        if(creep.memory.role.includes('thirdRoomUpgrader')) {
            thirdRoomUpgrader.run(creep);
        }

        if(creep.memory.role == 'W55N13THarvester') {
            W55N13.harvester(creep);
        }
        if(creep.memory.role == 'W55N13LEnergyCarry') {
            W55N13.energyCarry(creep);
        }
        if(creep.memory.role == 'W55N13LEnergyTransfer') {
            W55N13.energyTransfer(creep);
        }
        if(creep.memory.role == 'W55N13LResourcesTransfer') {
            W55N13.resourceTransfer(creep);
        }
        if(creep.memory.role == 'W55N13LATTACK') {
            W55N13.attack(creep);
        }
        if(creep.memory.role == 'W55N13LDefend') {
            W55N13.defend(creep);
            //creep.moveTo(new RoomPosition(2,39,'W54N13'))

        }

        //w54n9
        if(creep.memory.role == 'W54N9Harvester') {
            W54N9.harvester(creep);
        }
        if(creep.memory.role.indexOf('W54N9Upgrader') != -1){
            W54N9.run(creep);
        }
        //新greep
        if(creep.memory.role == 'W54N9THarvester') {
            W54N9.harvester(creep);
        }
        if(creep.memory.role == 'W54N9TEnergyCarry'){
            W54N9.energyCarry(creep)
        }
        if(creep.memory.role == 'W54N9TEnergyTransfer'){
            W54N9.energyTransfer(creep)
        }

        if(creep.memory.role.indexOf('W54N9TUpgrader') != -1){
            W54N9.upgrader(creep);
        }



        //w51n9
        if(creep.memory.role == 'W51N9THarvester') {
            W51N9.harvester(creep);
        }
        if(creep.memory.role == 'W51N9TEnergyCarry'){
            W51N9.energyCarry(creep)
        }
        if(creep.memory.role == 'W51N9TEnergyTransfer'){
            W51N9.energyTransfer(creep)
        }


        if(creep.memory.role.indexOf('W51N9Upgrader') != -1){
            W51N9.upgrader(creep);
        }
        //W54N8
        // if(creep.memory.role.indexOf('W54N8THarvester') != -1) {
        //     W54N8.harvester(creep);
        // }
        // if(creep.memory.role == 'W54N8TEnergyCarry'){
        //     W54N8.energyCarry(creep)
        // }
        // if(creep.memory.role == 'W54N8TEnergyTransfer'){
        //     W54N8.energyTransfer(creep)
        // }

        // if(creep.memory.role.indexOf('W54N8TUpgrader') != -1){
        //     W54N8.upgrader(creep);
        // }

        // if(creep.memory.role == 'W54N8L-AllAround') {
        //     W54N8.run(creep);
        // }
        


        //采集矿物
        if(creep.memory.role == 'mining'){
            roleMining.mining(creep);
        }
        if(creep.memory.role == 'miningCarry'){
            roleMining.carry(creep)
        }



        //转移能量



        // if(creep.memory.role == 'firstRoomHarvester') {
        //     firstRoomHarvester.run(creep);
        // }
        // if(creep.memory.role == 'firstRoomCarry') {
        //     firstRoomCarry.run(creep);
        // }
        //
        // if(creep.memory.role == 'attack'){
        //     roleClaimer.attack(creep);
        // }


    }

    //market.run()
    //market.terminal()
    // lab
    roleLab.lab();

    //link能量转移
    roleLink.link();
    roleLink.secondRoomLink();
    roleLink.W55N13Link();
    // roleLink.W51N9Link();
    //roleLink.W54N8Link();
    // roleLink.W54N9Link();

    //防御塔相关
    roleTower.run()


    //第二个房间creep生产
    //creepProduce.secondRoomCreep();
    //第三个房间creep生产
    creepProduce.thirdRoomCreep();
    // creepProduce.W54N9Creep();
    // creepProduce.W51N9Creep();

    //Spawn 显示生产信息 以及清除死去的creep信息
    creepProduce.creepUtil();

    creepProduce.transferCreep();
    //当前房间creep生产
    creepProduce.run();

    //右边房间内的creep生产
    //creepProduce.firstRoomCreep();

    
    
}